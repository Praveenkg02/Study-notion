    "target": "ES2020",
    "module": "commonjs",
    "allowJs": true,
    "checkJs": false,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "*": ["*"]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": ["**/*.js", "**/*.cjs", "**/*.mjs"]
}
